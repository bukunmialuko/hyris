# Backend
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
# Learner memory. Left commented out, profiles live in memory and die with the process. Uncomment
# after `docker compose up -d db` and they survive restarts. Plain libpq URL (psycopg rejects
# SQLAlchemy's "postgresql+psycopg://"); 5433 is the host port compose publishes for the db service.
# DATABASE_URL=postgresql://hyris:hyris@localhost:5433/hyris

# Signs device tokens. Without it the API cannot issue identities and every caller is "anonymous";
# there is deliberately no default, because a guessable signing key would make every identity
# forgeable while looking secure. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# AUTH_SECRET=

# Extension (Vite) — set ONE of these. There is no built-in default; with
# neither set the side panel shows a "no quiz source configured" error.
# Mock mode: any URL serving the quiz JSON contract.
VITE_QUIZ_URL=https://raw.githubusercontent.com/bukunmialuko/hyris/main/packages/contracts/fixtures/hyris-quiz.json
# Live mode: the FastAPI backend. Used only when VITE_QUIZ_URL is unset.
# VITE_API_BASE=http://localhost:8000
