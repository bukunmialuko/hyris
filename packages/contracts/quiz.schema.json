{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyris.app/schemas/quiz.schema.json",
  "title": "HyrisQuiz",
  "description": "A finished quiz, as returned in RunStatus.quiz and stored in quizzes.payload. Mirrors app.schemas.quiz.Quiz.",
  "type": "object",
  "required": ["id", "title", "questions"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "note": {
      "type": "string",
      "description": "User-facing note, set when the delivered count falls notably short of the request."
    },
    "truncated": {
      "type": "boolean",
      "description": "The article exceeded MAX_WORDS and was cut before analysis."
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slot_id", "question", "options", "correct_answer"],
        "properties": {
          "slot_id": {
            "type": "integer",
            "minimum": 0,
            "description": "The blueprint slot this question fills. Unique within a quiz, and the key an attempt answers under."
          },
          "concept": { "type": ["string", "null"] },
          "bloom_level": {
            "enum": ["remember", "understand", "apply", "analyse", "evaluate", "create", null]
          },
          "question": { "type": "string" },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "string" }
          },
          "correct_answer": { "type": "integer", "minimum": 0, "maximum": 3 },
          "explanation": { "type": ["string", "null"] }
        }
      }
    }
  }
}
