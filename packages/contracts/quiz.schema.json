{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyris.app/schemas/quiz.schema.json",
  "title": "HyrisQuizResponse",
  "type": "object",
  "required": ["quiz"],
  "properties": {
    "quiz": {
      "type": "object",
      "required": ["id", "title", "questions"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "source": {
          "type": "object",
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "page_title": { "type": "string" },
            "extracted_at": { "type": "string", "format": "date-time" }
          }
        },
        "profile": {
          "type": "object",
          "properties": {
            "education_level": { "enum": ["high_school", "undergraduate", "masters", "research"] },
            "difficulty": { "enum": ["easy", "medium", "hard", "expert"] },
            "cognitive_level": { "enum": ["remember", "understand", "apply", "analysis", "evaluate", "create"] },
            "question_style": { "type": "string" },
            "question_count": { "type": "integer", "minimum": 1, "maximum": 30 },
            "allow_trick_questions": { "type": "boolean" },
            "require_explanations": { "type": "boolean" }
          }
        },
        "concepts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "question", "options", "correct_answer"],
            "properties": {
              "id": { "type": "string" },
              "bloom_level": { "enum": ["remember", "understand", "apply", "analyse", "evaluate", "create"] },
              "concept": { "type": "string" },
              "question": { "type": "string" },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "items": { "type": "string" }
              },
              "correct_answer": { "type": "integer", "minimum": 0 },
              "explanation": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
